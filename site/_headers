# Feed RSS — cache court. Les apps podcast sondent selon leur propre horaire et
# récupèrent le nouvel épisode au plus tard 5 minutes après sa publication ;
# no-store forçait chaque sondage à repartir de l'origine.
/feed.xml
  Cache-Control: public, max-age=300

# Sitemap et robots — cache court
/sitemap.xml
  Cache-Control: public, max-age=3600

/robots.txt
  Cache-Control: public, max-age=3600

# Sécurité — toutes les pages
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
